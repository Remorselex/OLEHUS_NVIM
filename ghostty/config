# ═══════════════ Ghostty ═══════════════
# reload config: Cmd+Shift+,

# -- Appearance --
# the theme follows the macOS light/dark setting on its own
theme = Synthwave
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true

background-opacity = 0.85
background-blur = 20
window-colorspace = display-p3

# -- Window and padding --
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = tabs
# non-native fullscreen keeps transparency and blur working when maximised
macos-non-native-fullscreen = true
window-save-state = always
unfocused-split-opacity = 0.85

# -- Cursor and mouse --
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# -- Behaviour --
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# -- Splits --
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+enter=toggle_split_zoom

# -- Quick terminal: drops down on Cmd+` from anywhere --
keybind = global:cmd+grave_accent=toggle_quick_terminal

# -- Fullscreen through Ghostty's own action, so transparency survives --
keybind = ctrl+cmd+f=toggle_fullscreen
