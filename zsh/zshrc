# === NVIM-SOCKET: nvim listens on a socket so lazygit in another pane can hand it files ===
v() {
  local sock=/tmp/nvim.sock owner
  if ! { [ -e "$sock" ] && owner=$(nvim --server "$sock" --remote-expr 'getpid() . " " . getcwd()' 2>/dev/null); }; then
    rm -f "$sock"; nvim --listen "$sock" "$@"
    return
  fi

  # A live nvim already owns the socket, so this one starts plain, and lazygit keeps handing
  # files to the other one. Say which, or it looks as if lazygit stopped opening files at all.
  # getpid() is the embedded server; its parent is the UI that sits in a terminal tab.
  local ui_pid=$(ps -o ppid= -p "${owner%% *}" | tr -d ' ')
  local owner_dir=${owner#* }
  local warning="Сокет $sock держит другой nvim: PID $ui_pid, терминал $(ps -o tty= -p "$ui_pid" | tr -d ' '), запущен $(ps -o lstart= -p "$ui_pid" | sed "s/ *$//"), каталог ${owner_dir/#$HOME/~}. Файлы из lazygit уходят туда. Закрой его и здесь выполни :call serverstart('$sock')"
  print -u2 "v: $warning"
  V_SOCKET_WARNING=$warning nvim -c 'lua vim.defer_fn(function() vim.notify(os.getenv("V_SOCKET_WARNING"), vim.log.levels.WARN) end, 1000)' "$@"
}

# === WORKTREE-BLOCK: in the worktree model you don't switch branches, you move between dirs ===
# wt             pick a worktree with fzf and cd into it
# wt <substring> cd into the worktree whose path or branch contains it
# wt-add <branch> create a worktree for the branch next to the main tree
# wt-rm          pick a worktree and remove it
wt() {
  local worktrees target
  git rev-parse --git-common-dir >/dev/null 2>&1 || { echo "не git-репозиторий" >&2; return 1; }
  worktrees=$(git worktree list) || return 1

  if [ $# -gt 0 ]; then
    target=$(printf '%s\n' "$worktrees" | grep -i -- "$1" | head -1)
    [ -z "$target" ] && { echo "worktree с '$1' не найден:" >&2; printf '%s\n' "$worktrees" >&2; return 1; }
  else
    target=$(printf '%s\n' "$worktrees" | fzf --height 40% --reverse --prompt 'worktree> ') || return 1
  fi

  cd "${target%% *}" || return 1
  git status --short --branch | head -1
}

wt-add() {
  [ $# -eq 0 ] && { echo "wt-add <ветка> [каталог]" >&2; return 1; }
  local branch=$1 main_root dir
  # --path-format=absolute is required: from the main tree --git-common-dir
  # returns a relative ".git", which would put the worktree inside the repository
  main_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)") || return 1
  # name the directory after the branch, not wktr2/wktr3: a week later wktr2 means nothing
  dir=${2:-"$main_root-$(printf '%s' "$branch" | tr '/ ' '--')"}

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$dir" "$branch"
  else
    git worktree add -b "$branch" "$dir"
  fi && cd "$dir"
}

wt-rm() {
  local target
  target=$(git worktree list | tail -n +2 | fzf --height 40% --reverse --prompt 'удалить worktree> ') || return 1
  git worktree remove "${target%% *}" && git worktree list
}

# === COMMANDS-BLOCK: every command these zsh files define, in one fuzzy list ===
# commands          pick a command with fzf (the preview shows its definition) and put it on the prompt
# A command's description is its usage comment ("# name ...") when the file has one, else the comment
# right above it, else the comment or value of the alias. Names starting with _ are helpers, not listed.
__commands_list() {
  awk '
    FNR == 1 { above = "" }
    /^#[ \t]+[a-z][a-z0-9_-]*([ \t]|$)/ {
      split(substr($0, 2), words, /[ \t]+/)
      name = words[2]
      if (!(name in usage)) { usage[name] = $0; sub(/^#[ \t]+[^ \t]+[ \t]*/, "", usage[name]) }
    }
    /^#/ {
      if (!in_comment) { above = $0; sub(/^#+[ \t]*(=+[ \t]*)?/, "", above); sub(/[ \t]*=+[ \t]*$/, "", above) }
      in_comment = 1
      next
    }
    { in_comment = 0 }
    /^[a-zA-Z][a-zA-Z0-9_-]*\(\)/ {
      name = $0; sub(/\(\).*/, "", name)
      description = (name in usage && usage[name] != "") ? usage[name] : above
      printf "%-18s %s\n", name, description
    }
    /^alias [a-zA-Z]/ {
      name = $2; sub(/=.*/, "", name)
      description = $0
      if (description ~ /#/) sub(/^[^#]*#[ \t]*/, "", description); else sub(/^alias [^=]+=/, "", description)
      printf "%-18s %s\n", name, description
    }
    !/^[ \t]*$/ { above = "" }
  ' "$HOME/dotfiles/zsh/zshrc" "$HOME/.zshrc.local" 2>/dev/null | sort -u -k1,1
}

commands() {
  local definitions chosen name
  definitions=$(mktemp -d) || return 1
  # Definitions as the shell has them now, written once, so the preview needs no new zsh per line.
  __commands_list | while read -r name _; do
    { alias -L "$name" || whence -f "$name"; } > "$definitions/$name" 2>/dev/null
  done
  chosen=$(__commands_list | fzf --height 60% --reverse --prompt 'команда> ' \
    --preview "cat '$definitions'/{1}" --preview-window 'right,55%,wrap')
  rm -rf "$definitions"
  [ -n "$chosen" ] && print -z -- "${chosen%% *} "
}

