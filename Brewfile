# Terminal IDE: nvim plus git tooling. brew bundle --file=Brewfile
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"

brew "neovim"
brew "starship"          # prompt
brew "zoxide"            # directory jumps that remember where you go
brew "fzf"               # fuzzy finder
brew "eza"               # ls
brew "bat"               # cat with syntax highlighting
brew "glow"              # read markdown in the terminal (helpmevim)
brew "ripgrep"           # project-wide search; nvim pickers are dead without it
brew "fd"                # file search for the pickers
brew "w3m"               # text-mode browser

brew "lazygit"
brew "git-delta"         # line-level diff inside lazygit
brew "difftastic"        # structural diff (git dft)
brew "git-absorb"        # scatter edits into the commits that introduced them (Neogit: c x)
brew "tree-sitter"

brew "htop"              # classic process viewer
brew "btop"              # process viewer with graphs, mouse, per-core and disk/net panels
brew "macmon"            # Apple Silicon only: power draw, temperatures, P/E core frequencies
